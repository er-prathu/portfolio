# Contact form email delivery (Resend: https://resend.com). Copy this file to .env and fill it in.
# .env is git-ignored and never deployed. On Cloudflare Pages (or Vercel), add these in the project's settings as
# environment variables instead; mark RESEND_API_KEY as a Secret/encrypted. See DEPLOY.md.

# API key from Resend → API Keys (starts with re_). Sending access is enough.
RESEND_API_KEY=

# The inbox that should receive contact messages.
CONTACT_EMAIL=

# The sender. Must be on a domain you have verified in Resend → Domains, e.g.  Portfolio <contact@yourdomain.com>
# No domain yet? Use  Portfolio <onboarding@resend.dev>  and set CONTACT_EMAIL to the address your Resend account
# uses: Resend's shared test sender only delivers there. Switch to your own domain once you have one.
CONTACT_FROM_EMAIL=

# Optional: your site's origin(s), comma-separated, so only your own pages can post to the endpoint.
# ALLOWED_ORIGIN=https://yourproject.pages.dev
